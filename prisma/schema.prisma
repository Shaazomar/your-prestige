// Your Prestige — CMS Data Model
// Dev: SQLite (zero-setup). Production: switch provider to "postgresql"
// and point DATABASE_URL at your Postgres instance — the schema is
// written to be portable between the two.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ————— Users & RBAC —————

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  password  String // bcrypt hash
  role      Role      @default(VIEWER)
  active    Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  leadsAssigned Lead[]     @relation("AssignedLeads")
  leadNotes     LeadNote[]
  auditLogs     AuditLog[]
  posts         Post[]
}

enum Role {
  SUPER_ADMIN
  OWNER
  MARKETING
  CONTENT
  SEO
  SUPPORT
  VIEWER
}

// ————— Catalogue —————

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  image       String?
  sortOrder   Int       @default(0)
  products    Product[]
}

model Brand {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  logo        String?
  description String?
  featured    Boolean   @default(false)
  sortOrder   Int       @default(0)
  products    Product[]
}

model Product {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  collection     String? // e.g. "Lumina Marble Collection" — groups related SKUs
  description    String?
  finish         String?
  thickness      String?
  sizes          String? // JSON array: ["600 × 1200 mm", "800 × 1600 mm"]
  material       String?
  color          String?
  texture        String? // short descriptor, e.g. "Book-matched veining"
  applications   String? // JSON array: ["Living Room","Bathroom","Outdoor",...]
  lifestyleImage String? // dominant hero/card image — full room scene
  textureImage   String? // macro material close-up
  images         String? // JSON array of gallery/angle/installation media URLs
  video          String?
  brochureUrl    String? // catalog PDF
  tag            String? // "Bestseller" | "New Arrival" | "Designer Pick" | ...
  aspect         String? // "portrait" | "square" | "landscape" — masonry rhythm
  featured       Boolean  @default(false)
  designerPick   Boolean  @default(false)
  published      Boolean  @default(true)
  priceIndicator String? // "₹₹₹" — luxury catalogue, not ecommerce (yet)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  brandId    String?
  brand      Brand?    @relation(fields: [brandId], references: [id])

  seo Seo?
}

// ————— Portfolio / Gallery / Testimonials —————

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  type        String // Residential | Commercial | Villa | Apartment | Hotel
  client      String?
  location    String?
  year        String?
  description String?
  images      String? // JSON array
  video       String?
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())

  seo Seo?
}

model GalleryItem {
  id        String   @id @default(cuid())
  type      String   @default("image") // image | video
  url       String
  alt       String?
  tags      String? // JSON array
  folder    String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String?
  quote     String
  rating    Int      @default(5)
  videoUrl  String?
  source    String? // google | video | manual
  featured  Boolean  @default(false)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ————— Content —————

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  content     String // markdown / rich text
  coverImage  String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id])
  seo      Seo?
}

model Faq {
  id        String  @id @default(cuid())
  question  String
  answer    String
  category  String?
  sortOrder Int     @default(0)
  published Boolean @default(true)
}

model Offer {
  id          String    @id @default(cuid())
  title       String
  description String?
  image       String?
  validFrom   DateTime?
  validUntil  DateTime?
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

// ————— Leads & Conversations —————

model Lead {
  id         String     @id @default(cuid())
  type       LeadType   @default(CONTACT)
  status     LeadStatus @default(NEW)
  name       String
  phone      String
  email      String?
  city       String?
  message    String?
  interest   String? // tiles | sanitary | both | project
  budget     String?
  visitDate  DateTime? // for showroom bookings
  source     String? // website | concierge | whatsapp | walk-in
  utmSource  String?
  utmMedium  String?
  utmCampaign String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  assignedToId String?
  assignedTo   User?      @relation("AssignedLeads", fields: [assignedToId], references: [id])
  notes        LeadNote[]

  @@index([status, createdAt])
}

enum LeadType {
  CONTACT
  QUOTE
  VISIT
  CONCIERGE
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  VISITED
  QUOTED
  WON
  LOST
}

model LeadNote {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  leadId   String
  lead     Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId String?
  author   User?   @relation(fields: [authorId], references: [id])
}

model Conversation {
  id        String   @id @default(cuid())
  sessionId String
  messages  String // JSON array of {role, content, at}
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ————— SEO & Settings —————

model Seo {
  id          String  @id @default(cuid())
  path        String  @unique // page path this record governs
  title       String?
  description String?
  keywords    String?
  canonical   String?
  ogImage     String?
  jsonLd      String? // raw JSON-LD override
  noIndex     Boolean @default(false)

  productId String?  @unique
  product   Product? @relation(fields: [productId], references: [id])
  projectId String?  @unique
  project   Project? @relation(fields: [projectId], references: [id])
  postId    String?  @unique
  post      Post?    @relation(fields: [postId], references: [id])
}

model Redirect {
  id         String @id @default(cuid())
  fromPath   String @unique
  toPath     String
  statusCode Int    @default(301)
}

model Setting {
  key   String @id // e.g. "business.phone", "theme.accent", "maintenance.enabled"
  value String // JSON-encoded
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String // e.g. "lead.update", "product.delete"
  entity    String?
  entityId  String?
  meta      String? // JSON
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])
}
