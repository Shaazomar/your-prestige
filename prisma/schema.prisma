// Your Prestige — CMS Data Model (PostgreSQL / Neon)
//
// Conventions used throughout this schema:
// - Soft delete: models the admin can "delete & restore" carry `deletedAt`.
//   Deleting sets it; restoring clears it; queries filter `deletedAt: null`.
// - Audit trail: `createdById` / `updatedById` / `deletedById` are plain
//   string columns (NOT enforced foreign keys) storing a User.id. This is a
//   deliberate simplification — a hard FK on every content model back to
//   User would require ~90 unused back-relation arrays on User. The id is
//   resolved to a name/avatar in application code, and every mutation is
//   additionally written to AuditLog (a real FK) for a durable trail even
//   if the acting user is later deleted.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ————— Users & RBAC —————

enum Role {
  SUPER_ADMIN
  OWNER
  MARKETING
  CONTENT
  SEO
  SUPPORT
  VIEWER
}

enum UserStatus {
  ACTIVE
  INVITED
  DEACTIVATED
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String
  password  String // bcrypt hash
  role      Role       @default(VIEWER)
  status    UserStatus @default(ACTIVE)
  avatar    String?
  lastLogin DateTime?

  inviteToken     String?   @unique
  inviteExpiresAt DateTime?
  resetToken      String?   @unique
  resetExpiresAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leadsAssigned    Lead[]     @relation("AssignedLeads")
  leadNotes        LeadNote[]
  auditLogs        AuditLog[]
  posts            Post[]
  bookingsAssigned Booking[]  @relation("AssignedBookings")

  @@index([status])
  @@index([role])
}

// ————— Catalogue —————

model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  image       String?
  icon        String?
  sortOrder   Int     @default(0)
  published   Boolean @default(true)

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  products Product[]
  seo      Seo?

  createdById String?
  updatedById String?
  deletedById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([parentId])
  @@index([deletedAt])
}

model Brand {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  logo        String?
  banner      String?
  gallery     Json? // string[] of media URLs
  description String?
  website     String?
  catalogPdf  String?
  featured    Boolean @default(false)
  sortOrder   Int     @default(0)
  published   Boolean @default(true)

  products Product[]
  seo      Seo?

  createdById String?
  updatedById String?
  deletedById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([deletedAt])
}

model Product {
  id             String  @id @default(cuid())
  slug           String  @unique
  name           String
  collection     String? // e.g. "Lumina Marble Collection"
  description    String?
  finish         String?
  thickness      String?
  sizes          Json? // string[]
  material       String?
  color          String?
  texture        String? // short descriptor, e.g. "Book-matched veining"
  applications   Json? // string[] — room/space tags
  lifestyleImage String? // dominant hero/card image — full room scene
  textureImage   String? // macro material close-up
  images         Json? // string[] — gallery/angle/installation media
  video          String?
  brochureUrl    String? // catalog PDF
  tag            String? // "Bestseller" | "New Arrival" | ...
  aspect         String? // "portrait" | "square" | "landscape"
  relatedIds     Json? // string[] — manually curated related product ids
  featured       Boolean @default(false)
  designerPick   Boolean @default(false)
  published      Boolean @default(true)
  priceIndicator String? // "₹₹₹" — luxury catalogue, not ecommerce (yet)
  viewCount      Int     @default(0)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandId    String?
  brand      Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)

  seo Seo?

  createdById String?
  updatedById String?
  deletedById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([published, deletedAt])
  @@index([featured])
}

// ————— Portfolio / Gallery / Video / Testimonials —————

model Project {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  type           String // Residential | Commercial | Villa | Apartment | Hotel
  client         String?
  builder        String?
  architect      String?
  location       String?
  year           String?
  completionDate DateTime?
  description    String?
  images         Json? // string[]
  video          String?
  featured       Boolean   @default(false)
  published      Boolean   @default(true)

  seo Seo?

  createdById String?
  updatedById String?
  deletedById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([type])
  @@index([deletedAt])
}

model GalleryAlbum {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  description String?
  coverImage  String?
  sortOrder   Int     @default(0)
  published   Boolean @default(true)

  items GalleryItem[]

  createdById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model GalleryItem {
  id     String  @id @default(cuid())
  type   String  @default("image") // image | video
  url    String
  alt    String?
  tags   Json? // string[]
  folder String? // legacy free-text folder label

  albumId String?
  album   GalleryAlbum? @relation(fields: [albumId], references: [id], onDelete: SetNull)

  sortOrder Int @default(0)

  createdById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([albumId])
}

enum VideoProvider {
  YOUTUBE
  VIMEO
  UPLOAD
}

model Video {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  description String?
  provider    VideoProvider @default(YOUTUBE)
  url         String // embed/watch URL, or uploaded file URL
  thumbnail   String?
  category    String?
  featured    Boolean       @default(false)
  published   Boolean       @default(true)
  sortOrder   Int           @default(0)

  createdById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Testimonial {
  id              String  @id @default(cuid())
  name            String
  role            String?
  quote           String
  image           String?
  rating          Int     @default(5)
  videoUrl        String?
  googleReviewUrl String?
  source          String? // google | video | manual
  featured        Boolean @default(false)
  published       Boolean @default(true)

  createdById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ————— Content —————

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  content     String // markdown
  coverImage  String?
  category    String?
  tags        Json? // string[]
  published   Boolean   @default(false)
  publishedAt DateTime?
  scheduledAt DateTime?

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  seo      Seo?

  createdById String?
  updatedById String?
  deletedById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
  @@index([deletedAt])
}

model Faq {
  id        String  @id @default(cuid())
  question  String
  answer    String
  category  String?
  sortOrder Int     @default(0)
  published Boolean @default(true)

  createdById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Offer {
  id            String    @id @default(cuid())
  title         String
  description   String?
  image         String?
  validFrom     DateTime?
  validUntil    DateTime?
  showCountdown Boolean   @default(false)
  published     Boolean   @default(true)

  createdById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ————— Leads, Bookings & Conversations —————

enum LeadType {
  CONTACT
  QUOTE
  VISIT
  CONCIERGE
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  VISITED
  QUOTED
  WON
  LOST
}

model Lead {
  id          String     @id @default(cuid())
  type        LeadType   @default(CONTACT)
  status      LeadStatus @default(NEW)
  name        String
  phone       String
  email       String?
  city        String?
  message     String?
  interest    String?
  budget      String?
  visitDate   DateTime?
  source      String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  assignedToId String?
  assignedTo   User?      @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes        LeadNote[]
  booking      Booking?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([deletedAt])
}

model LeadNote {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  leadId   String
  lead     Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
}

enum BookingStatus {
  PENDING
  CONFIRMED
  RESCHEDULED
  COMPLETED
  CANCELLED
  REJECTED
  NO_SHOW
}

model Booking {
  id             String        @id @default(cuid())
  name           String
  phone          String
  email          String?
  requestedDate  DateTime
  preferredTime  String? // e.g. "10:00 AM" — free-text slot preference
  confirmedDate  DateTime?
  status         BookingStatus @default(PENDING)
  notes          String?
  interestedIn   Json? // string[] of product/category interests
  googleEventId  String? // set once synced to Google Calendar
  reminderSentAt DateTime?

  leadId String? @unique
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  showroomId String?
  showroom   Showroom? @relation(fields: [showroomId], references: [id], onDelete: SetNull)

  assignedConsultantId String?
  assignedConsultant   User?   @relation("AssignedBookings", fields: [assignedConsultantId], references: [id], onDelete: SetNull)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, requestedDate])
  @@index([showroomId])
  @@index([deletedAt])
}

// ————— Showrooms —————

model Showroom {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  /// Short descriptor shown under the name, e.g. "Jaquar Authorized Dealer"
  subtitle String?

  // Address
  addressLine String
  locality    String?
  city        String
  state       String  @default("Karnataka")
  postalCode  String?
  latitude    Float?
  longitude   Float?
  mapUrl      String? // Google Maps link
  mapEmbedUrl String? // optional iframe embed src
  directions  String? // free-text landmark/parking guidance

  // Contact
  phone        String
  whatsapp     String?
  email        String?
  managerName  String?
  managerPhone String?

  // Hours — weekday line plus a Sunday line, since Sunday differs per branch
  hoursWeekdays String @default("Monday–Saturday: 9:00 AM – 7:00 PM")
  hoursSunday   String @default("Sunday: Closed")

  // Media
  heroImage String?
  gallery   Json? // string[]
  video     String?

  description String?
  brands      Json? // string[] of brand names stocked here
  amenities   Json? // string[] e.g. "Customer Parking", "Design Consultation"

  featuredProductIds Json? // string[] of Product ids to spotlight

  isFlagship Boolean @default(false)
  published  Boolean @default(true)
  sortOrder  Int     @default(0)

  bookings Booking[]

  createdById String?
  updatedById String?
  deletedById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, deletedAt])
  @@index([city])
}

model Conversation {
  id            String  @id @default(cuid())
  sessionId     String
  messages      Json // [{role, content, at}]
  leadExtracted Boolean @default(false)
  resolved      Boolean @default(false)

  leadId String? @unique // set when a Lead is manually extracted from this chat

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([sessionId])
  @@index([deletedAt])
}

// ————— SEO & Settings —————

model Seo {
  id          String  @id @default(cuid())
  path        String  @unique // page path this record governs
  title       String?
  description String?
  keywords    String?
  canonical   String?
  ogImage     String?
  jsonLd      String? // raw JSON-LD override
  noIndex     Boolean @default(false)

  productId  String?   @unique
  product    Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  projectId  String?   @unique
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  postId     String?   @unique
  post       Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  categoryId String?   @unique
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  brandId    String?   @unique
  brand      Brand?    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
}

model Redirect {
  id         String  @id @default(cuid())
  fromPath   String  @unique
  toPath     String
  statusCode Int     @default(301)
  active     Boolean @default(true)
}

model Setting {
  key       String   @id // e.g. "business.phone", "theme.accent", "maintenance.enabled"
  value     Json
  updatedAt DateTime @updatedAt
}

// ————— Media Library —————

model MediaFolder {
  id       String        @id @default(cuid())
  name     String
  parentId String?
  parent   MediaFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children MediaFolder[] @relation("FolderTree")
  media    Media[]

  createdAt DateTime @default(now())
}

model Media {
  id       String  @id @default(cuid())
  url      String
  publicId String? // Cloudinary public id, if applicable
  filename String
  mimeType String
  size     Int // bytes
  width    Int?
  height   Int?
  altText  String?
  tags     Json? // string[]

  folderId String?
  folder   MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  uploadedById String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([folderId])
  @@index([deletedAt])
}

// ————— Audit Log —————

model AuditLog {
  id         String   @id @default(cuid())
  action     String // e.g. "lead.update", "product.delete"
  entity     String?
  entityId   String?
  oldValue   Json?
  newValue   Json?
  meta       Json?
  ipAddress  String?
  userAgent  String?
  roleAtTime String?
  createdAt  DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId, createdAt])
}
